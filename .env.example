# ── 应用配置 ──────────────────────────────────────────────
# 用于签发登录会话的密钥，务必改成一段随机长字符串
# 可用：openssl rand -base64 32
AUTH_SECRET="please-change-me-to-a-long-random-string"

# 上传图片保存目录（容器内路径），默认 public/uploads
UPLOAD_DIR="public/uploads"

# ── 数据库（PostgreSQL）─────────────────────────────────
# 本机直接跑（非 Docker）时用这个，指向本地 Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memoryboard?schema=public"

# ── docker compose 用的数据库账号（compose 会读取）──────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=memoryboard

# ── 限制注册 ────────────────────────────────────────────
# 设了这个口令后，只有知道口令的人才能注册账号（相当于"邀请制"）。
# 留空或删掉这一行 = 开放注册，任何人都能注册。
SIGNUP_CODE="change-me-signup-code"

# ── 站长（管理员）────────────────────────────────────────
# 填谁的邮箱，谁就是站长。只有站长能在「设置」页看到备份功能。
# 留空 = 没有站长，备份入口对所有人隐藏。
ADMIN_EMAIL=""

# ── WebDAV 备份（可选）───────────────────────────────────
# 配好后，站长可在「设置」页一键把数据库和照片备份到网盘，
# 防止服务器挂了数据全没。坚果云、Nextcloud、群晖等都支持 WebDAV。
# URL 要写到具体目录，程序会在下面建 db/ 和 photos/ 两个子目录。
# 注意：备份文件含所有人的留言和密码哈希，务必放在私有目录。
WEBDAV_URL=""
WEBDAV_USER=""
WEBDAV_PASSWORD=""
